# Copy to .env.local and fill in. Never commit real values.

# ── Supabase (production / real auth) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (Prisma) ─────────────────────────────────────────────────────────
# Supabase: DATABASE_URL = transaction pooler (6543, ?pgbouncer=true), DIRECT_URL = session pooler (5432)
# Local dev: both point at the local Postgres started by scripts/dev-setup.sh
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/laser_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/laser_dev

# ── Local development only ────────────────────────────────────────────────────
# Skip Supabase auth and act as a fixed dev user (dev@laser.local).
# Ignored by production builds (NODE_ENV=production). Uploads go to .dev-uploads/.
DEV_AUTH_BYPASS=true
