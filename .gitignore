# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Old Vite build output (pre-migration)
dist/
dist-ssr/

# Environment files — never commit these (contain secrets)
.env
.env.*
!.env.example

# Prisma generated client (regenerated via postinstall)
node_modules/.prisma/

# Claude Code — commit shared config, ignore personal/local files
.claude/settings.local.json
.claude/worktrees/

# Binary/data files in Examples
Examples/*.xlsx
Examples/*.pdf
Examples/*.svg

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local dev / testing artifacts
.dev-uploads/
screenshots/
playwright-report/
test-results/
.dev-server.log
.dev-server.pid
